[Unit]
Description=Noctalia shell (quickshell)
Documentation=https://docs.noctalia.dev
# Antes se lanzaba con 'exec-once' desde hyprland.conf: si el proceso moria,
# la sesion quedaba sin barra, sin notificaciones y sin launcher hasta
# reiniciar. En NVIDIA las superficies EGL se pierden cada tanto
# (eglSwapBuffers failed with 0x3000) y quickshell termina.
After=graphical-session.target
# Si Hyprland ya no esta (logout), qs falla al instante. Tras 5 intentos en
# 30s systemd se rinde, en vez de reintentar para siempre.
StartLimitIntervalSec=30
StartLimitBurst=5
# Noctalia es el shell de Hyprland. GNOME tambien activa
# graphical-session.target, asi que con [Install] WantedBy=... systemd lo
# levantaba tambien dentro de la sesion GNOME por RDP: ahi su widget de red
# corre 'nmcli networking connectivity check', y como esa sesion es Remote=yes
# sin Seat, polkit la deniega -> "System policy prevents control of network
# connections" cada pocos segundos.
#
# Por eso NO lleva [Install]: el unico que lo arranca es el exec-once de
# hyprland.conf, que por definicion solo corre bajo Hyprland.
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
ExecStart=/usr/bin/qs -c noctalia-shell
Restart=always
RestartSec=2
# El manager ya hereda esto de hyprland.conf via
# 'dbus-update-activation-environment --systemd --all', pero el orden de los
# exec-once no esta garantizado y sin QT_QPA_PLATFORM Qt no crea contexto EGL:
# noctalia arranca pero no dibuja ninguna layer.
Environment=QT_QPA_PLATFORM=wayland;xcb
Slice=session.slice
